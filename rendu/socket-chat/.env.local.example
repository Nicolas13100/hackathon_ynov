# Type de serveur d'inference choisi par l'equipe INFRA : "ollama" | "triton" | "custom"
INFERENCE_TYPE=ollama

# URL de base du serveur (sans / a la fin)
# Ollama   -> http://localhost:11434
# Triton   -> http://localhost:8000
# Maison   -> URL communiquee par l'equipe INFRA
INFERENCE_URL=http://localhost:11434

# Nom du modele tel qu'expose par le serveur d'inference
MODEL_NAME=phi3.5-financial
